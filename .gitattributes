# Default — normalize text files to LF in the repo, restore native on checkout
* text=auto eol=lf

# Force LF for files that MUST be Unix-style (Linux containers / scripts)
*.sh        text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# Treat as binary — don't touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary

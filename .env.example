# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="FastAPI Enterprise"
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALLOWED_ORIGINS_RAW=http://localhost:3000,http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Constructed by config.py — override only if needed
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/app_db

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
